          "apiVersion": "aifw.dev/v1alpha1",
          "kind": "CapabilitySpec",
          "capability": "aifw-control-plane",
          "title": "AIFW control plane",
          "purpose": "Tornar engenharia com agentes reproduzível, rastreável, segura e independente do executor.",
          "requirements": [
            {
              "id": "REQ-AIFW-BROWNFIELD",
              "strength": "MUST",
              "statement": "O framework deve mapear fatos de projetos existentes sem aprovar inferências semânticas automaticamente.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-BROWNFIELD-TWO-PHASE",
                  "given": [
                    "um projeto existente inicializado no AIFW"
                  ],
                  "when": [
                    "discovery e aplicação do baseline são executados"
                  ],
                  "then": [
                    "candidatos factuais são persistidos e permanecem pendentes de revisão humana"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-INTEGRITY-APPROVAL",
              "strength": "MUST",
              "statement": "O archive L3 deve revalidar aprovação humana e arquivo de registro existente dentro da raiz real do projeto.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-INTEGRITY-APPROVAL",
                  "given": [
                    "uma mudança ready cuja aprovação ou classificação foi alterada"
                  ],
                  "when": [
                    "archive é solicitado"
                  ],
                  "then": [
                    "a aprovação inválida bloqueia sem alterar current ou active"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-INTEGRITY-EVIDENCE",
              "strength": "MUST",
              "statement": "Artefatos passed devem apontar para arquivos dentro do projeto; gates ligados por checkedBy devem estar passed.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-INTEGRITY-EVIDENCE",
                  "given": [
                    "uma mudança com evidência ausente ou gate obrigatório não aprovado"
                  ],
                  "when": [
                    "ready ou archive é solicitado"
                  ],
                  "then": [
                    "a mudança é bloqueada e o cenário sem evidência não conta como verificado"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-INTEGRITY-RECOVERY",
              "strength": "MUST",
              "statement": "O archive deve preservar o estado instalado quando a limpeza de backups falhar, e restaurar o estado anterior quando uma troca falhar antes do commit.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-INTEGRITY-RECOVERY",
                  "given": [
                    "uma transação de archive com falha injetada de filesystem"
                  ],
                  "when": [
                    "a falha ocorre antes do commit ou durante a limpeza"
                  ],
                  "then": [
                    "o estado antigo é restaurado ou o novo é preservado com aviso de limpeza"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-INTEGRITY-UNIQUE-DELTA",
              "strength": "MUST",
              "statement": "Uma mudança deve possuir no máximo um delta por capability.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-INTEGRITY-UNIQUE-DELTA",
                  "given": [
                    "dois deltas da mesma capability com requisitos distintos"
                  ],
                  "when": [
                    "a mudança é validada"
                  ],
                  "then": [
                    "a duplicidade bloqueia antes de sobrescrever requisitos"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-INTEGRITY-VALID-OUTPUT",
              "strength": "MUST",
              "statement": "O lifecycle deve rejeitar títulos vazios e validar a CapabilitySpec produzida antes de staging.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-INTEGRITY-VALID-OUTPUT",
                  "given": [
                    "um delta com título vazio ou apenas espaços"
                  ],
                  "when": [
                    "a mudança é validada ou sincronizada"
                  ],
                  "then": [
                    "a operação falha antes de contaminar a árvore current"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-PERSISTED-TRUTH",
              "strength": "MUST",
              "statement": "Decisões arquiteturais e comportamentais devem existir em fontes versionadas do projeto e nunca somente em conversa com IA.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-PERSISTED-DECISION",
                  "given": [
                    "uma mudança arquitetural relevante"
                  ],
                  "when": [
                    "a decisão é aprovada"
                  ],
                  "then": [
                    "um ADR ou registro equivalente dentro do projeto contém a decisão e sua evidência"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-SPEC-LIFECYCLE",
              "strength": "MUST",
              "statement": "O framework deve isolar propostas em mudanças ativas e só alterar a verdade aceita após validação e archive controlado.",
              "scenarios": [
                {
                  "id": "SCN-AIFW-SPEC-ARCHIVE",
                  "given": [
                    "uma mudança pronta com tarefas e evidências completas"
