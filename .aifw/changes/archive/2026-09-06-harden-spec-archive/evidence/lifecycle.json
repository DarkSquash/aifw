                  "when": [
                    "o archive é executado"
                  ],
                  "then": [
                    "as specs atuais são trocadas atomicamente e o contexto completo é arquivado"
                  ]
                },
                {
                  "id": "SCN-AIFW-SPEC-PREVIEW",
                  "given": [
                    "uma mudança ativa com deltas válidos"
                  ],
                  "when": [
                    "o agente solicita o preview de sincronização"
                  ],
                  "then": [
                    "as alterações propostas são exibidas sem mutar as specs atuais"
                  ]
                }
              ]
            },
            {
              "id": "REQ-AIFW-TRACEABILITY",
              "strength": "MUST",
              "statement": "O framework deve detectar requisitos órfãos, cenários sem verificação, links quebrados e evidências ausentes.",
              "scenarios": [
