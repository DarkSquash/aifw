{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/decision-case.schema.json",
  "title": "AIFW DecisionCase",
  "type": "object",
  "additionalProperties": true,
  "required": ["apiVersion", "kind", "category", "impact", "signals", "rankings", "unansweredDrivers", "confidence", "requiresHumanApproval", "recordRequired", "digest"],
  "properties": {
    "apiVersion": { "const": "aifw.dev/v1alpha1" },
    "kind": { "const": "DecisionCase" },
    "category": { "type": "string", "minLength": 1 },
    "impact": { "enum": ["L1", "L2", "L3"] },
    "signals": { "type": "array", "items": { "type": "string" } },
    "rankings": { "type": "array", "minItems": 1 },
    "unansweredDrivers": { "type": "array" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "requiresHumanApproval": { "const": true },
    "recordRequired": { "const": "ADR" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
