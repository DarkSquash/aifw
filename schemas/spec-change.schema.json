{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/spec-change.schema.json",
  "title": "AIFW SpecChange",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "summary", "status"],
  "properties": {
    "apiVersion": { "const": "aifw.dev/v1alpha1" },
    "kind": { "const": "SpecChange" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "title": { "type": "string", "minLength": 1 },
        "level": { "enum": ["L0", "L1", "L2", "L3"] },
    "createdAt": { "type": "string" }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "active", "ready", "archived"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedBy", "approvedAt", "record"],
      "properties": {
        "approvedBy": { "type": "string", "pattern": "^human:" },
        "approvedAt": { "type": "string" },
        "record": { "type": "string", "minLength": 1 }
      }
    },
    "archivedAt": { "type": "string" }
  }
}
