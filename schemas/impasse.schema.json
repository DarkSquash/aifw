{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/impasse.schema.json",
  "title": "AIFW ImpasseCase",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "impact", "state", "attempts", "attemptFingerprints", "stopDestructiveChanges"],
  "properties": {
    "id": { "type": "string", "pattern": "^impasse:[a-z0-9-]+$" },
    "impact": { "enum": ["L0", "L1", "L2", "L3"] },
    "state": { "enum": ["NORMAL", "SUSPECTED", "OPEN", "HUMAN_REVIEW", "HALF_OPEN", "RESOLVED"] },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypothesis", "intervention", "evidence", "outcome", "occurredAt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hypothesis": { "type": "string", "minLength": 1 },
          "intervention": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "outcome": { "enum": ["success", "failure", "inconclusive"] },
          "occurredAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attemptFingerprints": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "stopDestructiveChanges": { "type": "boolean" },
    "openReason": { "enum": ["distinct-attempt-limit", "repeated-strategy"] },
    "proposal": { "type": "object" },
    "humanDecision": { "type": "object" },
    "revalidation": { "type": "object" }
  }
}
