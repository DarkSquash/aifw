{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/catalog.schema.json",
  "title": "AIFW ProjectCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "project", "sourcesOfTruth", "entities"],
  "properties": {
    "apiVersion": { "const": "aifw.dev/v1alpha1" },
    "kind": { "const": "ProjectCatalog" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "verifiedRevision"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "verifiedRevision": { "type": "string", "minLength": 1 }
      }
    },
    "sourcesOfTruth": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "source"],
        "properties": { "topic": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 } }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "description", "owner", "source", "visibility", "relations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["System", "Component", "API", "Resource", "DataStore", "Runtime", "ExternalDependency", "Contract", "Decision", "Runbook"] },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "visibility": { "enum": ["public", "restricted", "internal", "private"] },
          "origin": { "enum": ["manual", "discovered"] },
          "confidence": { "enum": ["candidate", "confirmed"] },
          "lastVerifiedAt": { "type": "string" },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "target"],
              "properties": {
                "type": { "enum": ["partOf", "dependsOn", "consumes", "provides", "providedBy", "storesIn", "runsOn", "documentedBy"] },
                "target": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
