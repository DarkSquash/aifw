{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/capability-spec.schema.json",
  "title": "AIFW CapabilitySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "capability", "title", "purpose", "requirements"],
  "properties": {
    "apiVersion": { "const": "aifw.dev/v1alpha1" },
    "kind": { "const": "CapabilitySpec" },
    "capability": { "$ref": "#/$defs/capabilityId" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "capabilityId": { "type": "string", "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^SCN-[A-Z0-9-]+$" },
        "given": { "$ref": "#/$defs/strings" },
        "when": { "$ref": "#/$defs/strings" },
        "then": { "$ref": "#/$defs/strings" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strength", "statement", "scenarios"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z0-9-]+$" },
        "strength": { "enum": ["MUST", "SHALL", "SHOULD", "MAY"] },
        "statement": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      }
    }
  }
}
