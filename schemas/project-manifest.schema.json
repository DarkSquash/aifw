{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifw.dev/schemas/project-manifest.schema.json",
  "title": "AIFW Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "aifw.dev/v1alpha1" },
    "kind": { "const": "Project" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameworkVersion",
        "projectType",
        "locale",
        "primaryEnvironment",
        "validationTargets",
        "profiles",
        "dataClassification",
        "externalAllowlist"
      ],
      "properties": {
        "frameworkVersion": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "projectType": { "enum": ["new", "existing"] },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "primaryEnvironment": { "enum": ["windows", "wsl", "linux"] },
        "validationTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows", "wsl", "linux", "linux-ci"] }
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dataClassification": {
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "externalAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["off", "shadow"] },
            "model": { "type": "string", "minLength": 1 },
            "features": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["tasks", "impasse", "context", "intake", "traceability", "decisions"] }
            }
          }
        }
      }
    }
  }
}
