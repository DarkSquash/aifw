{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit|Read|Grep|Glob|WebFetch|WebSearch|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || { echo 'AIFW is enabled in this project, but aifw-hook failed or is not installed on this machine. Install it with: uv tool install <aifw folder>, then: aifw claude install (see HOW_TO_USE). Until then, commands and edits in this project are blocked.' >&2; exit 2; }",
            "shell": "bash",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "aifw assess judge --hook || true",
            "shell": "bash",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || true",
            "shell": "bash",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || true",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || true",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || echo 'AIFW is enabled in this project, but aifw-hook failed or is not installed on this machine. Install it with: uv tool install <aifw folder>, then: aifw claude install (see HOW_TO_USE). Until then, commands and edits in this project are blocked.'",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aifw-hook || true",
            "shell": "bash",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
